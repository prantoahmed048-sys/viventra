# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.

# Supabase (Project Settings > API in your Supabase dashboard)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: only needed once you have real SSLCommerz merchant credentials ---
# Set these on Vercel (Project Settings > Environment Variables), NOT in this
# file if you ever share it — they're server secrets used by /api functions.
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_MODE=test        # "test" (sandbox) or "live"
# SUPABASE_SERVICE_ROLE_KEY=  # Project Settings > API > service_role (secret!)
